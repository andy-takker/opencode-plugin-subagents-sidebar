{
  "name": "opencode-plugin-subagents-sidebar",
  "version": "0.1.0",
  "description": "OpenCode plugin for live subagent monitoring, nested task status and clickable session navigation in a collapsible terminal sidebar",
  "type": "module",
  "license": "MIT",
  "author": "Sergey Natalenko (andy-takker)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andy-takker/opencode-plugin-subagents-sidebar.git"
  },
  "homepage": "https://github.com/andy-takker/opencode-plugin-subagents-sidebar#readme",
  "bugs": {
    "url": "https://github.com/andy-takker/opencode-plugin-subagents-sidebar/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-plugins",
    "ai-agents",
    "multi-agent",
    "coding-agent",
    "developer-tools",
    "terminal",
    "tui",
    "cli",
    "subagents",
    "sidebar",
    "opentui",
    "solidjs",
    "typescript",
    "bun"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.3.13",
  "exports": {
    "./tui": "./src/tui.tsx"
  },
  "files": [
    "src/model.ts",
    "src/controller.ts",
    "src/opencode-source.ts",
    "src/tui.tsx",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format:check": "biome format .",
    "format": "biome format --write .",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun test",
    "package:check": "bun scripts/check-package.ts",
    "prepack": "bun run check"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.5"
  },
  "peerDependencies": {
    "@opentui/core": "^0.8.0",
    "@opentui/solid": "^0.8.0",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@opencode/client": "2.2.5",
    "@opencode/theme": "2.2.5",
    "@opentui/core": "0.8.0",
    "@opentui/solid": "0.8.0",
    "@types/bun": "1.4.4",
    "solid-js": "1.9.17",
    "typescript": "7.0.2"
  }
}
